# Copie para .env e ajuste os valores:  cp .env.example .env
# O .env real NÃO vai para o Git.

# Domínio público da aplicação (o Uptime Kuma fica em status.<DOMAIN>)
DOMAIN=seu-subdominio.duckdns.org

# E-mail usado pelo Let's Encrypt para os certificados HTTPS
ACME_EMAIL=seu-email@exemplo.com

# Imagem publicada pela pipeline no GitHub Container Registry (tudo minúsculo)
IMAGE=ghcr.io/guilhermexisto/projeto_integrador_cloud_devops
IMAGE_TAG=latest

# Token do DuckDNS (usado por scripts/duckdns-update.sh)
DUCKDNS_TOKEN=
